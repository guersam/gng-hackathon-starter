{
  "name": "gng-hackathon-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.domain.config.ts && vitest run --config vitest.worker.config.ts",
    "test:browser": "playwright test",
    "test:browser:full": "YOIL_FULL_E2E=1 playwright test tests/browser/practice-full.spec.ts",
    "test:browser:scale": "YOIL_LOCAL_SCALE=1 playwright test tests/browser/local-scale.spec.ts --workers=1 --trace=on",
    "test:browser:visual": "playwright test tests/browser/visual.spec.ts --reporter=html",
    "check:game": "vitest run --config vitest.domain.config.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:theme": "node scripts/check-theme.mjs",
    "check": "pnpm check:boundaries && pnpm check:theme && pnpm typecheck && pnpm test && pnpm build",
    "check:release": "pnpm check && pnpm test:browser && pnpm test:browser:full",
    "deploy": "pnpm check && wrangler deploy",
    "smoke": "node scripts/smoke.mjs",
    "load": "node scripts/load.mjs"
  },
  "dependencies": {
    "@experiential/game-handoff-lab": "workspace:*",
    "@experiential/game-yoil-genius": "workspace:*",
    "@experiential/simulation-kit": "workspace:*",
    "@experiential/ui-foundation": "workspace:*",
    "@cloudflare/vite-plugin": "1.51.3",
    "@fontsource/gothic-a1": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@experiential/cloudflare-host": "workspace:*",
    "@cloudflare/vitest-pool-workers": "0.21.1",
    "@cloudflare/workers-types": "5.20260812.1",
    "@playwright/test": "^1.61.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.121.0"
  }
}
